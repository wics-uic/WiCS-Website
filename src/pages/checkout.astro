---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CheckoutContainer from '../components/CheckoutContainer.astro';
import button from '../assets/extra/button.svg';
import Confirmation from '../components/Cards/Confirmation.astro';

import cloud1 from '../assets/extra/cloud1.png';
import cloud2 from '../assets/extra/cloud2.png';
import whitecloud2 from '../assets/extra/whitecloud-2.svg';
import whitecloud3 from '../assets/extra/whitecloud-3.svg';
---

<Layout>
    <div class="relative isolate overflow-hidden flex flex-col min-h-screen">

        <!-- Clouds -->
        <img src={cloud1.src} alt="" class="cloud cloud-right" />
        <img src={cloud2.src} alt="" class="cloud cloud-left" />
        <img src={whitecloud2.src} alt="" class="cloud whitecloud-left" />
        <img src={whitecloud3.src} alt="" class="cloud whitecloud-right" />

        <Nav3 />

<!-- Cart Icon -->
<a
    href={`${import.meta.env.BASE_URL}cart`}
    aria-label="Shopping cart"
    class="fixed top-[50px] right-[5%] z-[99999]
           flex items-center justify-center
           w-[60px] h-[60px]
           bg-pink-300 rounded-2xl shadow-md
           max-[1050px]:top-[25px] max-[1050px]:right-5"
>
    <svg
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <circle cx="9" cy="21" r="1" />
        <circle cx="20" cy="21" r="1" />
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
    </svg>

    <span class="absolute -top-2 -right-2
                 bg-red-500 text-white text-xs font-bold
                 rounded-full w-5 h-5
                 flex items-center justify-center" 
           id="checkout-cart-count">
        0
    </span>
</a>

        <main class="flex flex-col items-center flex-1
                     mt-16 sm:mt-20 md:mt-28
                     px-4 sm:px-6
                     pt-8 sm:pt-10 md:pt-12
                     pb-16 sm:pb-24 md:pb-32">

            <!-- Checkout Heading -->
            <h1 class="font-lora font-semibold text-red-500 text-center
                       text-2xl xs:text-3xl sm:text-4xl
                       mb-3 sm:mb-5">
                Reserve Your Merch
            </h1>

            <h2 class="font-lora text-red-500 text-center
                       text-sm xs:text-base sm:text-lg
                       mb-6 sm:mb-9 md:mb-11">
                Complete the form below to reserve your items.
            </h2>

            <!-- Downward Arrow -->
            <div class="flex justify-center items-center
                        mb-8 sm:mb-12 md:mb-16">
                <img
                    class="w-5 sm:w-6 md:w-7 h-auto"
                    src={button.src}
                    alt="Downward arrow"
                />
            </div>

            <!-- Checkout Container -->
            <CheckoutContainer total={0} />

            <Confirmation />

        </main>

        <Footer background="bg-cream-300" />
    </div>
</Layout>


<style>
    :global(html) {
        background-color: #FFF7ED;
    }

    :global(body) {
        margin: 0;
        background: linear-gradient(
            to bottom,
            #FFD9D6 0%,
            #FFE2DE 55%,
            #FFF7ED 100%
        );
        background-repeat: no-repeat;
        background-size: 100% 45vw;
    }

    .cloud {
        position: absolute;
        z-index: -1;
        pointer-events: none;
        height: auto;
    }

    .cloud-left {
        bottom: 16vw;
        left: 0;
        width: 55vw;
    }

    .cloud-right {
        bottom: 53vw;
        right: 0;
        width: 55vw;
    }

    .whitecloud-left {
        top: 5vw;
        left: 0;
        width: 30vw;
    }

    .whitecloud-right {
        top: 1vw;
        right: 0;
        width: 35vw;
    }

    @media (orientation: portrait) {
        :global(body) {
            background-size: 100% 40vh;
        }

        .cloud-right,
        .cloud-left {
            width: 56vw;
        }

        .cloud-right {
            bottom: 114vw;
        }

        .cloud-left {
            bottom: 57vw;
        }

        .whitecloud-left {
            width: 40vw;
        }

        .whitecloud-right {
            width: 50vw;
        }
    }
</style>


<script>
    import { getCart, products } from '../scripts/cart';

    const cart = getCart();

    const total = cart.reduce(
        (sum, item) =>
            sum + products[item.id].price * item.quantity,
        0
    );

    const count = cart.reduce(
        (sum, item) => sum + item.quantity,
        0
    );

    const totalEl = document.getElementById('checkout-total');
    const countEl = document.getElementById('checkout-cart-count');

    if (totalEl) {
        totalEl.textContent = `$${total.toFixed(2)}`;
    }

    if (countEl) {
        countEl.textContent = String(count);
    }
</script>