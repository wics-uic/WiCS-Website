---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sublanding from '../components/Sublanding.astro';

import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/merch/productCard.astro';

import tshirtImage from '../assets/merch/tshirt.png';
import keychainImage from '../assets/merch/keychain.png';
import crewneckImage from '../assets/merch/crewneck.png';

const B = import.meta.env.BASE_URL;

const products = [
    {
        id:'tshirt',
        name: 'Short Sleeve T-shirt',
        price:'$15.00',
        image: tshirtImage,
        href: `${B}merch2_afterClick/?product=tshirt`,
        soldOut: false,
    },
    {
        id:'keychain',
        name: 'WiCS Keychain',
        price:'$3.00',
        image: keychainImage,
        href: `${B}merch2_afterClick/?product=keychain`,
        soldOut: true, // Keychain remains marked as Sold Out here too!
    },
      {
        id: 'crewneck',
        name: 'Long Sleeve Crewneck',
        price: '$25.00',
        image: crewneckImage,
        href: `${B}merch2_afterClick/?product=crewneck`,
        soldOut: false,
    },
];
---

<Layout>
    <Sublanding  />
    <Nav3/>

    <main class="min-h-screen px-6 py-12">

    <!--product detail part. (Joselyn/Rahi part)-->
     <section class="min-h-[300px]">
        </section>


    <!--You might also like part. (Jenny/Connie part)-->
     <section class="px-6 py-20">
       <div class="mx-auto max-w-[1264px]">

                <!-- You might also like.. -->
                <div class="mx-auto flex h-[225px] max-w-[909px]
                            items-center justify-center">

                    <h2 class="text-center font-lora text-[48px]
                               font-bold leading-none text-pink-600">
                        You might also like..
                    </h2>

                </div>


                <!-- 3 Cards -->
                <div class="mt-[30px]">

                    <ProductGrid>

                        <!-- Past Projects -->
                         <div class="flex aspect-[362/447] w-full max-w-[362px] min-w-0
                            flex-col justify-between gap-2
                            rounded-[30px] bg-red-100
                            p-6 sm:p-3 md:p-4 lg:p-6 xl:p-8">

                            <!-- text -->
                            <div class="min-w-0 text-orange-800
                            text-3xl sm:text-base md:text-xl lg:text-2xl xl:text-4xl
                            font-bold font-['Raleway'] leading-[1.1]">
                            Check out what we’ve done in the past!
                            </div>

                              <!-- Arrow -->
                            <a href="/pastprojects" 
                            class="self-end shrink-0
                                    flex items-center justify-center
                                    w-[75px] h-[55px]
                                    sm:w-10 sm:h-8
                                    md:w-12 md:h-9
                                    lg:w-16 lg:h-12
                                    xl:w-[75px] xl:h-[55px]
                                    bg-emerald-300 rounded-[37px]
                                    shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)]
                                    hover:scale-105 transition-transform">

                                    <span class="text-orange-50
                                                text-3xl sm:text-lg md:text-xl lg:text-2xl xl:text-3xl
                                                font-bold font-['Raleway']">
                                        →
                                    </span>
                            </a>
                        </div>
                        
                      


                        {products.map((product) => (
                            <div data-product={product.id}
                            class="relative w-full max-w-[362px]">
                                <ProductCard
                                    image={product.image}
                                    name={product.name}
                                    price={product.price}
                                    href={product.href}
                                    soldOut={product.soldOut}
                                    />
                                    </div>
                        ))}
  
                    </ProductGrid>

                </div>
        </div>
     </section>
    </main>

    <Footer background="bg-cream-300"/>
</Layout>

<script>
    const selected = new URLSearchParams(      
        window.location.search   
    ).get('product') || 'tshirt';     

    document.querySelectorAll<HTMLElement>('[data-product]')   //hide the selected product card.  
        .forEach((card) => {
            if (card.dataset.product === selected) {
                card.style.display = 'none';
            }
        });
</script>