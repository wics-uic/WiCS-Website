---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import image from '../assets/logo.png';
import MerchHero from '../components/MerchHero.astro';

interface Props {
    targetId: string;
}

const { targetId } = Astro.props;
---

<Layout>
    <Nav3/>

    <main class="min-h-screen px-6 py-12">
        <MerchHero> </MerchHero>
        
    </main>

    <Footer background="bg-cream-300"/>
</Layout>

