---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MerchHero from '../components/MerchHero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/merch/productCard.astro';

import tshirtImage from '../assets/merch/tshirt.png';
import keychainImage from '../assets/merch/keychain.png';
import crewneckImage from '../assets/merch/crewneck.png';

const B = import.meta.env.BASE_URL;

const products = [
    {
        id: 'tshirt',
        name: 'Short Sleeve T-shirt',
        price: '$15.00',
        image: tshirtImage,
        soldOut: false,
    },
    {
        id: 'keychain',
        name: 'WiCS Keychain',
        price: '$3.00',
        image: keychainImage,
        soldOut: false,
    },
    {
        id: 'crewneck',
        name: 'Long Sleeve Crewneck',
        price: '$25.00',
        image: crewneckImage,
        soldOut: false,
    },
];
---

<Layout>
    <Nav3 />

    <main>
        <MerchHero />
    </main>

    <main
        id="products"
        class="scroll-mt-32 px-6 py-12"
    >
        <ProductGrid>
            {products.map((product) => (
                <ProductCard
                    image={product.image}
                    name={product.name}
                    price={product.price}
                    href={`${B}productDetail/${product.id}`}
                    soldOut={product.soldOut}
                />
            ))}
        </ProductGrid>
    </main>

    <Footer background="bg-cream-300" />
</Layout>

<style is:global>
    @media (prefers-reduced-motion: no-preference) {
        html {
            scroll-behavior: smooth;
        }
    }
</style>