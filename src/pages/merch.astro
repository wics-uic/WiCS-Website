---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import image from '../assets/logo.png';
---

<Layout>
    <Nav3/>

    <main class="min-h-screen px-6 py-12">
        <h1 class="text-6xl pt-30 text-center mb-6">Merch Shop</h1>
        <p class="text-[32px] pb-3 text-center">Show your support and rep WiCS in style</p>
        <p class="text-lg text-center mb-6">Any questions and trouble regarding merch: wics.uic.officers@gmail.com</p>
    </main>

    <Footer background="bg-cream-300"/>
</Layout>