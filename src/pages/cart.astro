---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Nav3 />
 
    <main class="min-h-screen px-6 py-12">
    <div class= "bg-pink-100 p-6 rounded-lg w-80">
    
    <h2 class="text-xl font-bold text-center mb-4">
        Order Summary
    </h2>
    <p class= "mb-4">
        Sub Total: $43
    </p>

    <hr class= "my-3" />
    <p class= "mb-4">
        Total: $43
    </p>
    <p class= mb-4">
        Please pick up your order within one week from the WiCS Lounge
    </p>
    <button class="bg-teal-100 p-4 rounded-lg w-full mb-4">
    continue
    </button>

    </div>
    </main>

    <Footer background="bg-cream-300" />
</Layout>