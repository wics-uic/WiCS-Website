---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartSummary from '../components/CartSummary.astro';
import CartItem from '../components/CartItem.astro';
import Recommendations from '../components/Recommendations.astro';

import cloud2 from '../assets/extra/whitecloud-2.svg';
import cloud3 from '../assets/extra/whitecloud-3.svg';

const subtotal = 43;
const total = 43;

const B = import.meta.env.BASE_URL;
---

<Layout title="Cart">

  <body class="relative min-h-screen bg-[#FFF7ED] text-slate-800 flex flex-col justify-between">

    <div class="relative z-10 w-full flex flex-col items-center flex-grow">

      <!-- CART HERO -->
      <section class="cart-hero">

        <!-- Left Cloud -->
        <img
          src={cloud2.src}
          alt=""
          class="cart-cloud cart-cloud-left"
        />

        <!-- Right Cloud -->
        <img
          src={cloud3.src}
          alt=""
          class="cart-cloud cart-cloud-right"
        />

        <!-- Navigation -->
        <Nav merch={true} />

        <!-- Cart Icon -->
        <a
          href={`${B}cart`}
          class="cart-icon"
          aria-label="Shopping cart"
        >
          <svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>

          <span id="cart-count" class="cart-count">
            3
          </span>
        </a>

        <!-- Heading -->
        <div class="cart-heading">

          <h1 class="font-lora text-5xl font-bold text-[#A95C5D] mb-5">
            Cart
          </h1>

          <p class="font-lora text-xl text-[#A95C5D]">
            Ready to place your order?
          </p>

          <div class="mt-10 flex justify-center">
            <svg
              width="42"
              height="24"
              viewBox="0 0 42 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="text-[#D28E8E]"
            >
              <path
                d="M3 3L21 21L39 3"
                stroke="currentColor"
                stroke-width="5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

        </div>

      </section>

      <!-- CART CONTENT -->
      <main class="w-full max-w-6xl px-6 pt-10 pb-20">

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_340px] items-start">

          <!-- CART ITEMS -->
          <section>

            <!-- Table Header -->
            <div
              class="mb-4 grid grid-cols-[2fr_0.7fr_1fr_0.5fr]
                     items-center gap-4 rounded-2xl bg-[#FCE1DD]
                     p-4 font-lora text-sm font-bold
                     text-[#944029] shadow-sm"
            >
              <span>Product</span>
              <span>Total</span>
              <span class="text-center">Quantity</span>
              <span class="text-center">Delete</span>
            </div>

            <!-- Products -->
            <div class="flex flex-col gap-4">

              <CartItem
                name="WiCS Keychain"
                price={3}
                image="/WiCS-Website/KeyChain.png"
              />

              <CartItem
                name="Short Sleeve Tee"
                price={15}
                image="/WiCS-Website/ShortSleeve.png"
              />

              <CartItem
                name="Long Sleeve Crewneck"
                price={25}
                image="/WiCS-Website/Crewneck.png"
              />

            </div>

          </section>

          <!-- ORDER SUMMARY -->
          <aside class="w-full">

            <CartSummary
              subtotal={subtotal}
              total={total}
              checkoutUrl="/WiCS-Website/checkout"
            />

          </aside>

        </div>

      </main>

      <!-- RECOMMENDATIONS -->
      <section class="w-full px-6 pb-20">
        <Recommendations />
      </section>

    </div>

    <!-- FOOTER -->
    <footer class="relative z-10 w-full">
      <Footer />
    </footer>

  </body>

</Layout>


<style>

  /* =========================
     CART HERO
     ========================= */

  .cart-hero {
    position: relative;
    width: 100%;
    height: 360px;

    background: linear-gradient(
      180deg,
      var(--color-pink-100),
      var(--color-cream-300)
    );

    overflow: hidden;
  }


  /* =========================
     CLOUDS
     ========================= */

  .cart-cloud {
    position: absolute;
    pointer-events: none;
    z-index: 1;
    height: auto;
  }

  .cart-cloud-left {
    left: 0;
    bottom: -10px;
    width: 430px;
  }

  .cart-cloud-right {
    right: 0;
    bottom: -10px;
    width: 560px;
  }


  /* =========================
     HERO TEXT
     ========================= */

  .cart-heading {
    position: relative;
    z-index: 5;

    text-align: center;
    padding-top: 125px;
  }


  /* =========================
     CART ICON
     ========================= */

  .cart-icon {
    position: absolute;

    top: 35px;
    right: 4%;

    z-index: 20;

    background-color: #F7B9BB;

    padding: 9px;

    border-radius: 12px;

    box-shadow: 0 4px 8px rgb(0 0 0 / 0.12);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cart-icon:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgb(0 0 0 / 0.15);
  }


  /* Cart Item Count */

  .cart-count {
    position: absolute;

    top: -7px;
    right: -7px;

    background-color: #9F4B38;
    color: white;

    font-size: 11px;
    font-weight: 700;

    border-radius: 9999px;

    min-width: 19px;
    height: 19px;

    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* =========================
     RESPONSIVE
     ========================= */

  @media (max-width: 768px) {

    .cart-hero {
      height: 320px;
    }

    .cart-cloud-left {
      width: 330px;
      left: -100px;
      bottom: 0;
    }

    .cart-cloud-right {
      width: 390px;
      right: -120px;
      bottom: 0;
    }

    .cart-heading {
      padding-top: 120px;
    }

    .cart-icon {
      top: 25px;
      right: 5%;
    }

  }

</style>


<script>

  function updateCartTotal() {

    let total = 0;
    let count = 0;

    document
      .querySelectorAll(".cart-item")
      .forEach((item) => {

        const priceEl =
          item.querySelector("[data-price]");

        const qtyEl =
          item.querySelector(".quantity-number");


        if (
          !(priceEl instanceof HTMLElement) ||
          !(qtyEl instanceof HTMLElement)
        ) {
          return;
        }


        const basePrice =
          Number(priceEl.dataset.baseprice);

        const qty =
          Number(qtyEl.textContent);


        total += basePrice * qty;
        count += qty;

      });


    /* Update subtotal */

    const subtotalEl =
      document.querySelector(
        "[data-cart-subtotal]"
      );


    /* Update total */

    const totalEl =
      document.querySelector(
        "[data-cart-total]"
      );


    if (subtotalEl) {
      subtotalEl.textContent = `$${total}`;
    }


    if (totalEl) {
      totalEl.textContent = `$${total}`;
    }


    /* Update Cart Badge */

    const countEl =
      document.getElementById("cart-count");


    if (countEl) {
      countEl.textContent = String(count);
    }

  }



  /* =========================
     INCREASE QUANTITY
     ========================= */

  document
    .querySelectorAll(
      "[aria-label='Increase quantity']"
    )
    .forEach((btn) => {

      btn.addEventListener("click", () => {

        const parent =
          btn.parentElement;

        const qtyEl =
          parent?.querySelector(
            ".quantity-number"
          );


        if (!qtyEl) return;


        let qty =
          Number(qtyEl.textContent);


        qty++;


        qtyEl.textContent =
          String(qty);


        updateCartTotal();

      });

    });



  /* =========================
     DECREASE QUANTITY
     ========================= */

  document
    .querySelectorAll(
      "[aria-label='Decrease quantity']"
    )
    .forEach((btn) => {

      btn.addEventListener("click", () => {

        const parent =
          btn.parentElement;

        const qtyEl =
          parent?.querySelector(
            ".quantity-number"
          );


        if (!qtyEl) return;


        let qty =
          Number(qtyEl.textContent);


        if (qty > 1) {

          qty--;

          qtyEl.textContent =
            String(qty);

          updateCartTotal();

        }

      });

    });



  /* =========================
     DELETE ITEM
     ========================= */

  document
    .querySelectorAll(
      "[aria-label='Delete item']"
    )
    .forEach((btn) => {

      btn.addEventListener("click", () => {

        btn
          .closest(".cart-item")
          ?.remove();


        updateCartTotal();

      });

    });



  /* Initial count / total */

  updateCartTotal();

</script>