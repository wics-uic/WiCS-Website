
---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartSummary from '../components/CartSummary.astro';
import Recommendations from '../components/Recommendations.astro';

import cloud2 from '../assets/extra/whitecloud-2.svg';
import cloud3 from '../assets/extra/whitecloud-3.svg';

const subtotal = 0;
const total = 0;

const B = import.meta.env.BASE_URL;
---

<Layout title="Cart">

  <body class="relative min-h-screen bg-[#FFF7ED] text-slate-800 flex flex-col justify-between">

    <div class="relative z-10 w-full flex flex-col items-center flex-grow">

      <!-- CART HERO -->
      <section class="cart-hero">

        <!-- Left Cloud -->
        <img
          src={cloud2.src}
          alt=""
          class="cart-cloud cart-cloud-left"
        />

        <!-- Right Cloud -->
        <img
          src={cloud3.src}
          alt=""
          class="cart-cloud cart-cloud-right"
        />

        <!-- Navigation -->
        <Nav merch={true} />

        <!-- Cart Icon -->
        <a
          href={`${B}cart`}
          class="cart-icon"
          aria-label="Shopping cart"
        >
          <svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>

          <span id="cart-count" class="cart-count">
            0
          </span>
        </a>

        <!-- Heading -->
        <div class="cart-heading">

          <h1 class="font-lora text-5xl font-bold text-[#A95C5D] mb-5">
            Cart
          </h1>

          <p class="font-lora text-xl text-[#A95C5D]">
            Ready to place your order?
          </p>

          <div class="mt-10 flex justify-center">
            <svg
              width="42"
              height="24"
              viewBox="0 0 42 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="text-[#D28E8E]"
            >
              <path
                d="M3 3L21 21L39 3"
                stroke="currentColor"
                stroke-width="5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

        </div>

      </section>

      <!-- CART CONTENT -->
      <main class="w-full max-w-6xl px-6 pt-10 pb-20">

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_340px] items-start">

          <!-- CART ITEMS -->
          <section>

            <!-- Table Header -->
            <div
              class="mb-4 grid grid-cols-[2fr_0.7fr_1fr_0.5fr]
                     items-center gap-4 rounded-2xl bg-[#FCE1DD]
                     p-4 font-lora text-sm font-bold
                     text-[#944029] shadow-sm"
            >
              <span>Product</span>
              <span>Total</span>
              <span class="text-center">Quantity</span>
              <span class="text-center">Delete</span>
            </div>

            <!-- Products are loaded from localStorage -->
            <div
              id="cart-items"
              class="flex flex-col gap-4"
            ></div>

          </section>

          <!-- ORDER SUMMARY -->
          <aside class="w-full">

            <CartSummary
              subtotal={subtotal}
              total={total}
              checkoutUrl={`${B}checkout`}
            />

          </aside>

        </div>

      </main>

      <!-- RECOMMENDATIONS -->
      <section class="w-full px-6 pb-20">
        <Recommendations />
      </section>

    </div>

    <!-- FOOTER -->
    <footer class="relative z-10 w-full">
      <Footer />
    </footer>

  </body>

</Layout>

<style>

  /* =========================
     CART HERO
     ========================= */

  .cart-hero {
    position: relative;
    width: 100%;
    height: 360px;

    background: linear-gradient(
      180deg,
      var(--color-pink-100),
      var(--color-cream-300)
    );

    overflow: hidden;
  }

  /* =========================
     CLOUDS
     ========================= */

  .cart-cloud {
    position: absolute;
    pointer-events: none;
    z-index: 1;
    height: auto;
  }

  .cart-cloud-left {
    left: 0;
    bottom: -10px;
    width: 430px;
  }

  .cart-cloud-right {
    right: 0;
    bottom: -10px;
    width: 560px;
  }

  /* =========================
     HERO TEXT
     ========================= */

  .cart-heading {
    position: relative;
    z-index: 5;

    text-align: center;
    padding-top: 125px;
  }

  /* =========================
     CART ICON
     ========================= */

  .cart-icon {
    position: absolute;

    top: 35px;
    right: 4%;

    z-index: 20;

    background-color: #F7B9BB;

    padding: 9px;

    border-radius: 12px;

    box-shadow: 0 4px 8px rgb(0 0 0 / 0.12);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cart-icon:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgb(0 0 0 / 0.15);
  }

  /* Cart Item Count */

  .cart-count {
    position: absolute;

    top: -7px;
    right: -7px;

    background-color: #9F4B38;
    color: white;

    font-size: 11px;
    font-weight: 700;

    border-radius: 9999px;

    min-width: 19px;
    height: 19px;

    display: flex;
    align-items: center;
    justify-content: center;
  }


/* =========================
   DYNAMIC CART ITEMS
   ========================= */

:global(.cart-item) {
    display: grid;
    grid-template-columns: 2fr 0.7fr 1fr 0.5fr;
    align-items: center;
    gap: 16px;

    padding: 16px;
    margin-bottom: 16px;

    background-color: #FCE1DD;
    border-radius: 16px;
    box-shadow: 0 4px 6px rgb(0 0 0 / 0.12);

    font-family: "Lora", serif;
}

:global(.cart-item > div:first-child) {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
}

:global(.cart-product-image) {
    width: 80px;
    height: 80px;
    object-fit: contain;
    border-radius: 12px;
    flex-shrink: 0;
}

:global(.cart-item p) {
    color: #9F4B38;
}

:global(.cart-item button) {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #9F4B38;
    color: white;
    border-radius: 9999px;
    cursor: pointer;
}

:global(.cart-item button[aria-label="Increase quantity"]),
:global(.cart-item button[aria-label="Decrease quantity"]) {
    width: 20px;
    height: 20px;
}

:global(.cart-item button[aria-label="Delete item"]) {
    width: 24px;
    height: 24px;
}

:global(.cart-item > div:nth-child(3)) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

:global(.cart-item > div:nth-child(4)) {
    display: flex;
    justify-content: center;
}

:global(.cart-item .quantity-number) {
    color: #9F4B38;
    font-weight: 600;
}


  /* =========================
     RESPONSIVE
     ========================= */

  @media (max-width: 768px) {

    .cart-hero {
      height: 320px;
    }

    .cart-cloud-left {
      width: 330px;
      left: -100px;
      bottom: 0;
    }

    .cart-cloud-right {
      width: 390px;
      right: -120px;
      bottom: 0;
    }

    .cart-heading {
      padding-top: 120px;
    }

    .cart-icon {
      top: 25px;
      right: 5%;
    }

  }

</style>

<script>
  import {
    getCart,
    products,
    changeQuantity,
    removeFromCart,
    type ProductId
  } from '../scripts/cart';

  const cartContainer =
    document.getElementById('cart-items');

  /* =========================
     DISPLAY CART ITEMS
     ========================= */

  function renderCart(): void {
    if (!cartContainer) return;

    const cart = getCart();

    if (cart.length === 0) {

      cartContainer.innerHTML = `
        <div class="rounded-2xl bg-[#FCE1DD] p-8 text-center text-[#944029]">
          <p class="font-lora text-xl font-bold">
            Your cart is empty!
          </p>
          <p class="mt-2">
            Add some WiCS merch to get started.
          </p>
        </div>
      `;

    } else {

      cartContainer.innerHTML = cart.map((item) => {

        const product = products[item.id];
        const lineTotal = product.price * item.quantity;

        return `
          <div
            class="cart-item bg-[#FCE1DD] p-4 rounded-2xl shadow-md grid grid-cols-[2fr_0.7fr_1fr_0.5fr] items-center gap-4 mb-4"
            style="font-family: 'Lora', serif;"
            data-id="${item.id}"
            data-size="${item.size ?? ''}"
          >

            <!-- Product Image and Name -->
            <div class="flex items-center gap-4">

              <img
                src="${product.image}"
                alt="${product.name}"
                class="cart-product-image w-20 h-20 object-contain rounded-xl"
              />

              <div>
                <p class="font-semibold text-sm text-[#9F4B38]">
                  ${product.name}
                </p>

                ${item.size ? `
                  <p class="text-xs text-[#9F4B38]">
                    Size: ${item.size}
                  </p>
                ` : ''}

              </div>
            </div>

            <!-- Product Total -->
            <p class="font-bold text-[#9F4B38]">
              $${lineTotal.toFixed(2)}
            </p>

            <!-- Quantity Controls -->
            <div class="flex items-center justify-center gap-2">

              <button
                type="button"
                data-action="decrease"
                aria-label="Decrease quantity"
                class="bg-[#9F4B38] text-white rounded-full w-5 h-5 flex items-center justify-center text-sm"
              >
                −
              </button>

              <span class="font-semibold text-[#9F4B38] quantity-number">
                ${item.quantity}
              </span>

              <button
                type="button"
                data-action="increase"
                aria-label="Increase quantity"
                class="bg-[#9F4B38] text-white rounded-full w-5 h-5 flex items-center justify-center text-sm"
              >
                +
              </button>

            </div>

            <!-- Delete Button -->
            <div class="flex justify-center">

              <button
                type="button"
                data-action="delete"
                aria-label="Delete item"
                class="bg-[#9F4B38] text-white rounded-full w-6 h-6 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 6h18" />
                  <path d="M8 6V4h8v2" />
                  <path d="M19 6l-1 14H6L5 6" />
                  <path d="M10 10v7" />
                  <path d="M14 10v7" />
                </svg>
              </button>

            </div>

          </div>
        `;

      }).join('');
    }

    updateCartTotal();
  }

  /* =========================
     UPDATE TOTAL AND COUNT
     ========================= */

  function updateCartTotal(): void {

    const cart = getCart();

    const total = cart.reduce(
      (sum, item) =>
        sum + products[item.id].price * item.quantity,
      0
    );

    const count = cart.reduce(
      (sum, item) => sum + item.quantity,
      0
    );

    const subtotalEl =
      document.querySelector('[data-cart-subtotal]');

    const totalEl =
      document.querySelector('[data-cart-total]');

    const countEl =
      document.getElementById('cart-count');

    if (subtotalEl) {
      subtotalEl.textContent = `$${total.toFixed(2)}`;
    }

    if (totalEl) {
      totalEl.textContent = `$${total.toFixed(2)}`;
    }

    if (countEl) {
      countEl.textContent = String(count);
    }
  }

  /* =========================
     QUANTITY AND DELETE
     ========================= */

  cartContainer?.addEventListener('click', (event) => {

    if (!(event.target instanceof Element)) return;

    const button =
      event.target.closest<HTMLButtonElement>(
        'button[data-action]'
      );

    if (!button) return;

    const cartItem =
      button.closest<HTMLElement>('.cart-item');

    if (!cartItem) return;

    const id =
      cartItem.dataset.id as ProductId;

    const size =
      cartItem.dataset.size || null;

    const action =
      button.dataset.action;

    if (action === 'increase') {

      changeQuantity(id, size, 1);

    } else if (action === 'decrease') {

      changeQuantity(id, size, -1);

    } else if (action === 'delete') {

      removeFromCart(id, size);

    }

    renderCart();
  });

  /* =========================
     INITIAL LOAD
     ========================= */

  renderCart();

</script>
