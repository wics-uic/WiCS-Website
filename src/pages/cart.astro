---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartSummary from '../components/CartSummary.astro';

const subtotal = 0;
const total = 0;
---

<Layout title="Cart">
  <Nav />
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart</title>
  </head>

  <body class="relative min-h-screen bg-[#FFF7ED] text-slate-800 flex flex-col justify-between">
    <div class="relative z-10 w-full flex flex-col items-center flex-grow">
      
      <!-- Header Text -->
      <header class="w-full text-center pt-32 pb-14">
        <h1 class="font-lora text-5xl font-bold text-[#A95C5D] mb-5">
          Cart
        </h1>

        <p class="font-lora text-xl text-[#A95C5D]">
          Ready to place your order?
        </p>

        <div class="mt-10 flex justify-center">
          <svg
            width="42"
            height="24"
            viewBox="0 0 42 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="text-[#D28E8E]"
          >
            <path
              d="M3 3L21 21L39 3"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </header>

      <!-- Layout for Cart Items + Summary -->
      <main class="w-full max-w-5xl px-4 sm:px-6 lg:px-8 pb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

          <!-- Order Summary -->
          <aside class="lg:col-span-4 w-full">
            <CartSummary subtotal={subtotal} total={total} checkoutUrl="/checkout" />
          </aside>
        </div>

      </main>
    </div> 

    <!-- Footer -->
    <footer class="relative z-10 w-full">
      <Footer/>
    </footer>
    
  </body>
</Layout>