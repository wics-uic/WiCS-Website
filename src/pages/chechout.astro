---
import Layout from '../layouts/Layout.astro';
import Nav3 from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Pickup from '../components/Pickup.astro';
import button from '../assets/extra/button.svg';
import logo from "../assets/logo.png";
import cloud2 from '../assets/extra/whitecloud-2.svg';
import cloud3 from '../assets/extra/whitecloud-3.svg';
import ContactInfo from '../components/MerchCheckout/ContactInfo.astro'
---

<Layout>
    <Nav3/>
    <div class="flex justify-center flex-1 mt-20 p-10">
            <ContactInfo/>     
    </div>
    <div  class="px-3 py-2">
            <img src={logo.src} alt="Logo" class="w-12 h-auto">
    </div>
    <main>
        <h1 class="flex justify-center font-semibold text-4xl font-lora text-red-500 mb-5">Reserve Your Merch</h1>
        <h2 class="flex justify-center text-l font-lora text-red-500 mb-11">Complete the form below to reserve your items.</h2>
        <div class="flex justify-center items-center ">
            <img class="w-7 h-auto" src={button.src}  alt="chevron" />
        </div>
        
        
       
        <div class="flex justify-center">
            <Pickup total = {43}/> 
        </div>
        <Footer background="bg-cream-300"/>
    

    </main>

</Layout>