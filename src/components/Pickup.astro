---
import "../styles/global.css";

interface Props{
    total: number;
}

const {total} = Astro.props;
---

<div class="bg-pink-300 rounded-2xl shadow-lg p-8 my-6 max-w-md">
    <h3 class=" font-semibold text-xl font-lora text-red-500 mb-4">Pickup & Payment</h3>
    <h5 class="font-lora font-semibold text-sm text-red-500 mb-1">Estimated Pickup Date</h5>

    <p class="font-lora text-red-500 mb-4 text-xs">Please enter your preferred pickup date within 7 days of your order confirmation.</p>

    <input 

        type="text"
        name="pickupDate"
        placeholder="MM/DD/YY"
        class="w-full bg-cream-200 rounded-full px-4 py-2  shadow-md font-raleway text-sm text-red-500 placeholder:text-red-300 placeholder:italic focus:outline-none focus:ring-2 focus:ring-red-300 mb-8"
    />

    <h5 class="font-lora font-semibold text-sm text-red-500 mb-1">Payment is made at pickup</h5>

    <p class="font-lora text-red-500 mb-8 text-xs">WICS merch is available for in-person purchase only. Payment must be made when you pick up your order using cash,Zelle,or Venmo. Online payment is not available.</p>
   
    <h5 class="font-lora font-semibold text-sm text-red-500 mb-1">Order Total</h5>

    <p class="font-lora font-bold text-2xl text-red-500">${total.toFixed(2)}</p>

    <a class="bg-[#71C3C3] text-[#FFF4ED] md:text-sm sm:text-sm xs:text-md text-sm md:px-6 px-4 py-1 shadow-[0_4px_4px_0_rgba(64,64,64,0.6)] mt-5 mb-5 rounded-full font-bold font-raleway inline-block text-center hover:bg-[#5a9d9d] transition">Reserve Order</a>

</div>
