---
import type { ImageMetadata } from 'astro';

interface Props {
    image: string | ImageMetadata;
    name: string;
    price: string;
}

const { image, name, price } = Astro.props;

const imgSrc =
    typeof image === 'string'
        ? image
        : image.src;
---

<article class="w-full max-w-[362px]">
    <img
        src={imgSrc}
        alt={name}
        class="aspect-[362/447] w-full rounded-[30px] object-cover"
    />

    <div class="mt-[35px] font-raleway text-red-500">
        <h3 class="text-[24px] font-bold leading-[38px]">
            {name}
        </h3>

        <p class="text-[32px] font-bold leading-[38px]">
            {price}
        </p>
    </div>
</article>