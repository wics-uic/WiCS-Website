
---
export interface Props {
    title?: string;
}

const {
    title = "Contact Information"
} = Astro.props;
---

<section class="w-full max-w-[254px] rounded-xl bg-[#FFCFCA] px-8 py-7 font-lora shadow-sm">

    <!-- Title -->
    <h2 class="mb-4 text-lg font-bold text-[#944029]">
        {title}
    </h2>

    <div class="flex flex-col gap-4">

        <!-- Full Name -->
        <div>
            <label
                for="full-name"
                class="mb-1 block text-xs font-semibold text-[#944029]"
            >
                Full Name (First Last)
            </label>

            <input
                id="full-name"
                name="fullName"
                type="text"
                placeholder="Type here..."
                class="w-full rounded-full bg-[#FFF5E8] px-3 py-1.5
                       text-xs text-[#944029] shadow-sm outline-none
                       placeholder:italic placeholder:text-[#AF8081]
                       focus:ring-2 focus:ring-[#71C3C3]"
            />
        </div>

        <!-- UIC Email -->
        <div>
            <label
                for="uic-email"
                class="block text-xs font-semibold text-[#944029]"
            >
                UIC Email
            </label>

            <p class="mb-1 text-[10px] text-[#AF8081]">
                If current student:
            </p>

            <input
                id="uic-email"
                name="uicEmail"
                type="email"
                placeholder="Type here..."
                class="w-full rounded-full bg-[#FFF5E8] px-3 py-1.5
                       text-xs text-[#944029] shadow-sm outline-none
                       placeholder:italic placeholder:text-[#AF8081]
                       focus:ring-2 focus:ring-[#71C3C3]"
            />
        </div>

        <!-- Personal Email -->
        <div>
            <label
                for="personal-email"
                class="block text-xs font-semibold text-[#944029]"
            >
                Personal Email
            </label>

            <p class="mb-1 text-[10px] text-[#AF8081]">
                If alumni:
            </p>

            <input
                id="personal-email"
                name="personalEmail"
                type="email"
                placeholder="Type here..."
                class="w-full rounded-full bg-[#FFF5E8] px-3 py-1.5
                       text-xs text-[#944029] shadow-sm outline-none
                       placeholder:italic placeholder:text-[#AF8081]
                       focus:ring-2 focus:ring-[#71C3C3]"
            />
        </div>

    </div>

</section>
