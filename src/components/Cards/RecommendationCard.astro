---
interface props {
  title: string;
  price: string;
  image: string;
  href?: string;
}

const { title, price, image, href = "#" } = Astro.props;
---

<div class="flex flex-col items-center">
    <a href={href} class="group w-full max-w-[180px] bg-white rounded-2xl p-4 shadow-sm border border-[#FBE3E4] hover:shadow-md transition-shadow flex items-center justify-center aspect-square">      
        <img 
        src={image} 
        alt={title} 
        class="w-24 h-24 object-contain group-hover:scale-105 transition-transform"/>
    </a>

    <div class="mt-3 text-center">  
        <h4 class="text-xs font-medium text-[#7A3645] leading-tight">{title}</h4>
        <p class="text-xs font-semibold text-[#7A3645] mt-1">{price}</p>
    </div>
</div>