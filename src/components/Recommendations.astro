---
import RecommendationCard from './Cards/RecommendationCard.astro';
import { getMerch } from '../libs/merch.js';
import logo from '../assets/logo.png';

interface RecommendationItem {
  id: string;
  title: string;
  price: string;
  image: string;
}

interface Props {
  items?: RecommendationItem[];
}

// Retrieve merchandise from Google Sheets
const merch = await getMerch();

console.log("Merch from Google Sheets:", merch);

// Format products for recommendation cards
const recommendedItems: RecommendationItem[] = merch.map((product) => ({
  id: String(product.id),
  title: product.merch_name,
  price: product.merch_price !== null
    ? `$${product.merch_price.toFixed(2)}`
    : 'Price unavailable',
  image: product.merch_picture ?? logo.src,
}));

const { items = recommendedItems } = Astro.props;
---

<section class="m-8 sm:p-3 md:p-8 max-w-5xl mx-auto">
  <h2 class="text-2xl font-serif text-[#7A3645] mb-6">You might also like..</h2>

  <div class="flex p-10 hide-scroll-bar overflow-x-scroll gap-6">
    {items.map((item) => (
      <RecommendationCard
        title={item.title}
        price={item.price}
        image={item.image}
      />
    ))}
  </div>
</section>